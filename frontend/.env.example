# All three are read by the Next.js server when it runs, not when it is built:
# one build works in every environment.

# Base URL of the backend API, as the browser should call it.
#   Absolute: the browser calls the API directly. The API's CORS must allow the frontend.
#   /api:     the browser calls only the frontend, whose proxy forwards /api/* to the backend.
API_BASE_URL=http://localhost:8000/api

# Backend origin (no /api) that the frontend's proxy forwards to when API_BASE_URL=/api.
API_PROXY_TARGET=http://localhost:8000

# Upload limit applied by the frontend's proxy. Use the same value as the backend.
MAX_UPLOAD_MB=10
