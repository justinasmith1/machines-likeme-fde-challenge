# Copy to .env and fill in. Never commit .env.
# Base URL of the v1 API. Requests go to {AZURE_OPENAI_ENDPOINT}/responses
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT=JustinaSmith-RCS2

PRICE_TOLERANCE_PCT=0.02
ANALYST_APPROVAL_LIMIT=5000

REFERENCE_DATA_DIR=data/reference
DATABASE_URL=sqlite:///./contoso.db

# Extraction
EXTRACTION_MAX_RETRIES=3
EXTRACTION_TIMEOUT_SECONDS=90
EXTRACTION_CACHE_DIR=data/cache/extractions
PDF_RENDER_DPI=170
PDF_MAX_PAGES=5
MAX_UPLOAD_MB=10

# Uploaded documents
UPLOADS_DIR=data/uploads
